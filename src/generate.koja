alias TimeZone.Rules

@doc """
The `tz.generate` task behind `koja run tz.generate`. Reads the tzdata
release that `bin/update-tzdata.sh` compiled into `build/tzdata/`,
packs every zone, checks that each one decodes back to the same
rules, and writes the `src/data/` files that `zone` reads.

Run it from the package root. It takes no arguments. The script runs
it for you and formats the output afterward.
"""
struct Generate
end

impl Koja.Task for Generate
  fn run(args: List<String>) ! String
    version = (try read_text("#{BUILD_DIR}/version")).trim()
    (zones, links) = try read_index("#{BUILD_DIR}/tzdata.zi")
    IO.puts(
      "packing #{zones.length()} zones and #{links.length()} links from tzdata #{version}",
    )

    regions: Map<String, List<(String, String)>> = Map.new()

    for zone in zones
      packed = try pack_zone(zone)
      key = region(zone)

      entries =
        match regions.get(key)
          Option.Some(existing) -> existing
          Option.None -> List.new()
        end

      regions = regions.put(key, entries.append((zone, packed)))
    end

    File.mkdir_p(DATA_DIR)
      rescue message -> fail "cannot create #{DATA_DIR}: #{message}"

    region_names: List<String> = List.new()

    for (name, _) in regions
      region_names = region_names.append(name)
    end

    for name in sort_strings(region_names)
      entries = regions.get(name).unwrap()
      try write_text(
        "#{DATA_DIR}/#{file_name(name)}.koja",
        region_content(version, name, entries),
      )
    end

    try write_text(
      "#{DATA_DIR}/index.koja",
      index_content(version, sort_strings(region_names), zones, links),
    )
    try write_text("#{DATA_DIR}/version.koja", version_content(version))
    IO.puts("wrote #{DATA_DIR} for tzdata #{version}")
  end
end

priv const BUILD_DIR: String = "build/tzdata"
priv const DATA_DIR: String = "src/data"
priv const OTHER_REGION: String = "other"

# Reads the zone's TZif file, packs it, and proves the packed text
# decodes to the same rules.
priv fn pack_zone(zone: String) -> String ! String
  path = "#{BUILD_DIR}/zoneinfo/#{zone}"
  bytes = File.read_binary(path)
    rescue message -> fail "cannot read #{path}: #{message}"
  rules = try read_tzif(zone, bytes)
  packed = pack(rules)

  if unpack(zone, packed) != rules
    fail "#{zone}: packed text does not decode to the same rules"
  end

  packed
end

# The `Z name ...` and `L target name` lines of tzdata.zi, as sorted
# zone names and sorted `(name, target)` links.
priv fn read_index(path: String)
  -> (List<String>, List<(String, String)>) ! String

  text = try read_text(path)
  zones: List<String> = List.new()
  links: List<(String, String)> = List.new()

  for line in text.split("\n")
    words = line.split(" ").filter(word -> not word.empty?())

    match (words.get(0), words.get(1), words.get(2))
      (Option.Some("Z"), Option.Some(name), _) -> zones = zones.append(name)
      (Option.Some("L"), Option.Some(target), Option.Some(name)) ->
        links = links.append((name, target))
      _ -> ()
    end
  end

  (sort_strings(zones), sort_links(links))
end

# Links in name order, through a map from name to target.
priv fn sort_links(links: List<(String, String)>) -> List<(String, String)>
  targets: Map<String, String> = Map.new()
  names: List<String> = List.new()

  for (name, target) in links
    targets = targets.put(name, target)
    names = names.append(name)
  end

  sort_strings(names).map(name -> (name, targets.get(name).unwrap()))
end

# The part of an identifier before the first `/`, or `other` for a
# name with no slash such as `CET`.
priv fn region(identifier: String) -> String
  match identifier.split("/").get(0)
    Option.Some(head) -> head == identifier ? OTHER_REGION : head
    Option.None -> OTHER_REGION
  end
end

priv fn file_name(region: String) -> String
  region.downcase()
end

priv fn function_name(region: String) -> String
  "#{region.downcase()}_packed"
end

priv fn header(version: String) -> String
  """
  # Generated by `koja run tz.generate` from tzdata #{version}. Do not
  # edit by hand. Run `bin/update-tzdata.sh <release>` to refresh it.
  """
end

priv fn region_content(
  version: String,
  region: String,
  entries: List<(String, String)>,
) -> String

  lines: List<String> = [
    header(version), "",
    "priv fn #{function_name(region)}(identifier: String) -> Option<String>",
    "  match identifier"
  ]

  for (zone, packed) in entries
    lines = lines.append("    #{quote(zone)} -> Option.Some(#{quote(packed)})")
  end

  lines = lines.append("    _ -> Option.None").append("  end").append("end")
  String.join(lines, "\n") <> "\n"
end

priv fn index_content(
  version: String,
  regions: List<String>,
  zones: List<String>,
  links: List<(String, String)>,
) -> String

  lines: List<String> = [
    header(version), "",
    "# The packed text for a zone, found through the region before its",
    "# first `/`.", "priv fn packed(identifier: String) -> Option<String>",
    "  match region(identifier)"
  ]

  for name in regions
    if name != OTHER_REGION
      lines = lines.append(
        "    #{quote(name)} -> #{function_name(name)}(identifier)",
      )
    end
  end

  # Names with no `/` such as `CET` are all links since tzdata 2024b,
  # so the fallback arm only calls a function when one was written.
  fallback = regions.any?(name -> name == OTHER_REGION)
    ? "#{function_name(OTHER_REGION)}(identifier)"
    : "Option.None"

  lines = lines.append("    _ -> #{fallback}")
    .append("  end")
    .append("end")
    .append("")
    .append("# The zone a link name points at.")
    .append("priv fn link_target(identifier: String) -> Option<String>")
    .append("  match identifier")

  for (name, target) in links
    lines = lines.append("    #{quote(name)} -> Option.Some(#{quote(target)})")
  end

  lines = lines.append("    _ -> Option.None")
    .append("  end")
    .append("end")
    .append("")
    .append("priv fn zone_identifiers -> List<String>")
    .append("  [")

  for zone in zones
    lines = lines.append("    #{quote(zone)},")
  end

  lines = lines.append("  ]")
    .append("end")
    .append("")
    .append("priv fn link_identifiers -> List<String>")
    .append("  [")

  for (name, _) in links
    lines = lines.append("    #{quote(name)},")
  end

  lines = lines.append("  ]").append("end")
  String.join(lines, "\n") <> "\n"
end

priv fn version_content(version: String) -> String
  triple = "\"\"\""
  lines: List<String> = [
    header(version), "", "@doc #{triple}",
    "The IANA tz database release the zone data came from, such as", "`2026c`.",
    triple, "const IANA_VERSION: String = #{quote(version)}"
  ]
  String.join(lines, "\n") <> "\n"
end

# A Koja string literal. Zone names and packed text hold no quotes,
# backslashes, or `#`, so the text is wrapped as is.
priv fn quote(text: String) -> String
  "\"#{text}\""
end

priv fn read_text(path: String) -> String ! String
  File.read(path) rescue message -> fail "cannot read #{path}: #{message}"
end

priv fn write_text(path: String, content: String) ! String
  File.write(path, content)
    rescue message -> fail "cannot write #{path}: #{message}"

  ()
end

# Merge sort by bytes, since `String` has no ordering of its own.
priv fn sort_strings(items: List<String>) -> List<String>
  if items.length() <= 1
    return items
  end

  half = items.length() / 2
  left = sort_strings(items.slice(0, half))
  right = sort_strings(items.slice(half, items.length() - half))
  merged: List<String> = List.new()
  i = 0
  j = 0

  while i < left.length() and j < right.length()
    a = left.get(i).unwrap()
    b = right.get(j).unwrap()

    if string_less?(b, a)
      merged = merged.append(b)
      j += 1
    else
      merged = merged.append(a)
      i += 1
    end
  end

  merged.concat(left.slice(i, left.length() - i))
    .concat(right.slice(j, right.length() - j))
end

priv fn string_less?(a: String, b: String) -> Bool
  left = a.to_binary()
  right = b.to_binary()
  index = 0

  while index < left.byte_size() and index < right.byte_size()
    x = left.at(index).unwrap()
    y = right.at(index).unwrap()

    if x != y
      return x < y
    end

    index += 1
  end

  left.byte_size() < right.byte_size()
end
