# Generated by `koja run tz.generate` from tzdata 2026e. Do not
# edit by hand. Run `bin/update-tzdata.sh <release>` to refresh it.

# The packed text for a zone, found through the region before its
# first `/`.
priv fn packed(identifier: String) -> Option<String>
  match region(identifier)
    "Africa" -> africa_packed(identifier)
    "America" -> america_packed(identifier)
    "Antarctica" -> antarctica_packed(identifier)
    "Asia" -> asia_packed(identifier)
    "Atlantic" -> atlantic_packed(identifier)
    "Australia" -> australia_packed(identifier)
    "Etc" -> etc_packed(identifier)
    "Europe" -> europe_packed(identifier)
    "Indian" -> indian_packed(identifier)
    "Pacific" -> pacific_packed(identifier)
    _ -> other_packed(identifier)
  end
end

